# Googer admin standalone runtime contract

NODE_ENV=production
PORT=3002
SERVE_NEXT=true

WEB_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
CORS_ORIGIN=https://admin.example.com

BACKEND_URL=http://admin-app:3002
GOOGER_MAIN_API_URL=https://api.example.com

JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
OPS_MONITOR_TOKEN=replace-with-a-long-random-ops-token
TEXT_LK_TOKEN=replace-with-text-lk-token

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10

BACKGROUND_WORKER_POLL_MS=1000
BACKGROUND_WORKER_RETRY_MS=30000
DEACTIVATED_USER_CLEANUP_MS=3600000
